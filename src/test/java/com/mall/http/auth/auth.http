{
  "skus": [
    {
      "skuCode": "INVALID-{{productId}}-STOCK",
      "price": 4999.00,
      "stock": -1,
      "lowStock": 2,
      "pic": null,
      "specs": [
        {
          "productAttributeId": 3,
          "value": "黑色"
        }
      ]
    }
  ]
}

> {%
    client.test("负库存被参数校验拒绝", function () {
        client.assert(response.status === 400, "预期 HTTP 400，实际为 " + response.status);
        client.assert(response.body.code === 40001, "预期参数校验错误码 40001");
    });
%}

