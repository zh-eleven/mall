### 19. 不携带 Token，应返回 401
# @name requestWithoutToken
GET {{baseUrl}}/api/admin/products/{{productId}}/skus

> {%
    client.test("未登录请求被拒绝", function () {
        client.assert(response.status === 401, "预期 HTTP 401，实际为 " + response.status);
        client.assert(response.body.code === 40100, "预期未登录错误码 40100");
    });
%}

### 20. 商品上架
# @name publishProduct
PATCH {{baseUrl}}/api/admin/products/{{productId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "publishStatus": 1
}

> {%
    client.test("商品上架成功", function () {
        client.assert(response.status === 200, "预期 HTTP 200，实际为 " + response.status);
        client.assert(response.body.data.publishStatus === 1, "商品状态应该为已上架");
    });
%}

### 21. 已上架商品整体替换 SKU，应返回 40926
# @name replaceSkuOfPublishedProduct
PUT {{baseUrl}}/api/admin/products/{{productId}}/skus
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "skus": [
    {
      "skuCode": "PUBLISHED-{{productId}}-BLACK",
      "price": 4999.00,
      "stock": 10,
      "lowStock": 2,
      "pic": null,
      "specs": [
        {
          "productAttributeId": 3,
          "value": "黑色"
        }
      ]
    }
  ]
}

> {%
    client.test("已上架商品 SKU 修改被拒绝", function () {
        client.assert(response.status === 409, "预期 HTTP 409，实际为 " + response.status);
        client.assert(response.body.code === 40926, "预期业务错误码 40926");
    });
%}

### 22. 恢复商品为下架状态
# @name unpublishProduct
PATCH {{baseUrl}}/api/admin/products/{{productId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "publishStatus": 0
}

> {%
    client.test("商品恢复下架状态", function () {
        client.assert(response.status === 200, "预期 HTTP 200，实际为 " + response.status);
        client.assert(response.body.data.publishStatus === 0, "商品状态应该恢复为下架");
    });
%}

### 23. 最终确认正确 SKU 未被异常请求覆盖
# @name finalSkuCheck
GET {{baseUrl}}/api/admin/products/{{productId}}/skus
Authorization: Bearer {{adminToken}}

> {%
    client.test("最终 SKU 数据保持正确", function () {
        client.assert(response.status === 200, "预期 HTTP 200，实际为 " + response.status);
        client.assert(response.body.data.length === 2, "最终应该仍有 2 个正确 SKU");
    });
%}
