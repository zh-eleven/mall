@baseUrl = http://localhost:8080
@memberUsername = test003
@memberPassword = 123456

### 1. 会员登录
POST {{baseUrl}}/api/members/login
Content-Type: application/json

{
  "username": "{{memberUsername}}",
  "password": "{{memberPassword}}"
}

> {%
    client.test("会员登录成功", function () {
        client.assert(response.status === 200);
        client.assert(response.body.code === 200);
    });

    client.global.set(
        "memberToken",
        response.body.data.token
    );
%}

### 2. 查询待支付订单详情
GET {{baseUrl}}/api/members/me/orders/{{submittedOrderId}}
Authorization: Bearer {{memberToken}}

> {%
    const order = response.body.data;

    client.test("待支付订单详情正确", function () {
        client.assert(response.status === 200);
        client.assert(response.body.code === 200);
        client.assert(order != null);

        if (order != null) {
            client.assert(
                String(order.orderSn)
                === client.global.get("submittedOrderSn")
            );

            client.assert(order.status === 0);
            client.assert(
                order.statusDescription === "待支付"
            );

            client.assert(
                Array.isArray(order.items)
                && order.items.length > 0
            );

            client.assert(order.receiver != null);
        }
    });
%}

### 3. 取消订单
PATCH {{baseUrl}}/api/members/me/orders/{{submittedOrderId}}/cancel
Authorization: Bearer {{memberToken}}

> {%
    const order = response.body.data;

    client.test("订单取消成功", function () {
        client.assert(response.status === 200);
        client.assert(response.body.code === 200);
        client.assert(order != null);

        if (order != null) {
            client.assert(order.status === 4);
            client.assert(
                order.statusDescription === "已取消"
            );

            client.assert(
                order.cancelTime != null,
                "取消时间不能为空"
            );
        }
    });
%}

### 4. 再次查询订单详情
GET {{baseUrl}}/api/members/me/orders/{{submittedOrderId}}
Authorization: Bearer {{memberToken}}

> {%
    const order = response.body.data;

    client.test("订单状态已经持久化", function () {
        client.assert(response.status === 200);
        client.assert(response.body.code === 200);
        client.assert(order.status === 4);
        client.assert(order.cancelTime != null);
    });
%}

### 5. SKU可用库存应恢复
GET {{baseUrl}}/api/products/{{submitProductId}}

> {%
    const skuId =
        client.global.get("submitSkuId");

    const sku = response.body.data.skus.find(
        item => String(item.id) === skuId
    );

    const expected =
        Number(
            client.global.get("stockBeforeSubmit")
        );

    client.test("取消订单后库存释放成功", function () {
        client.assert(sku != null);

        if (sku != null) {
            client.assert(
                sku.availableStock === expected,
                "预期库存：" + expected
                + "，实际库存：" + sku.availableStock
            );
        }
    });
%}

### 6. 不能重复取消订单
PATCH {{baseUrl}}/api/members/me/orders/{{submittedOrderId}}/cancel
Authorization: Bearer {{memberToken}}

> {%
    client.test("重复取消返回状态冲突", function () {
        client.assert(response.status === 409);
        client.assert(response.body.code === 40932);
    });
%}

### 7. 查询不存在的订单
GET {{baseUrl}}/api/members/me/orders/999999999
Authorization: Bearer {{memberToken}}

> {%
    client.test("不存在的订单返回404", function () {
        client.assert(response.status === 404);
        client.assert(response.body.code === 40414);
    });
%}